{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "batch_id": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "canonical_work_id": { "type": "string" },
          "identity_group_key": { "type": "string" },
          "edition_group_key": { "type": "string" },
          "scope": {
            "type": "string",
            "enum": ["standalone_work", "collection", "volume", "part", "excerpt", "paratext", "article", "reference"]
          },
          "contains_work_ids": { "type": "array", "items": { "type": "string" } },
          "contained_by_work_ids": { "type": "array", "items": { "type": "string" } },
          "topic_keys": { "type": "array", "items": { "type": "string" } },
          "portfolio_role": {
            "type": "string",
            "enum": ["essential", "core", "strong", "supporting", "specialized", "redundant"]
          },
          "comparative_priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Relativní priorita v celém korpusu; 100 je nejvyšší a 0 nejnižší."
          },
          "author_rank": { "type": "integer", "minimum": 1, "maximum": 500 },
          "standalone_value": { "type": "string", "enum": ["high", "medium", "low"] },
          "reason_cz": { "type": "string" }
        },
        "required": [
          "id",
          "canonical_work_id",
          "identity_group_key",
          "edition_group_key",
          "scope",
          "contains_work_ids",
          "contained_by_work_ids",
          "topic_keys",
          "portfolio_role",
          "comparative_priority",
          "author_rank",
          "standalone_value",
          "reason_cz"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["batch_id", "results"],
  "additionalProperties": false
}
